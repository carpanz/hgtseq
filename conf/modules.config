/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Only the outputs configured below are published
    publishDir = [
        enabled: false
    ]

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        READS QC, TRIMMING AND ALIGNMENT
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'FASTQC_RAW' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/QC/fastqc_raw" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TRIMGALORE' {
        ext.args   = '--illumina'
        publishDir = [
            path: { "${params.outdir}/preprocess/trimming" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FASTQC_TRIMMED' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/QC/fastqc_trimmed" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BWA_MEM|BWAMEM2_MEM' {
        publishDir = [
            path: { "${params.outdir}/preprocess/alignment" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}_sorted" }
        publishDir = [
            path: { "${params.outdir}/preprocess/alignment" },
            mode: params.publish_dir_mode
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        ALIGNMENT QC
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'QUALIMAP_BAMQC' {
        publishDir = [
            path: { "${params.outdir}/QC/qualimap" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/QC/bamtools/stats" },
            mode: params.publish_dir_mode
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        EXTRACTION AND CLASSIFICATION OF UNMAPPED READS
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    // Paired reads (1), unmapped (4), with a mapped mate (-8), primary alignments only (-256)
    withName: 'SAMTOOLS_VIEW_SINGLE' {
        ext.args   = '--output-fmt bam -f 5 -F 264'
        publishDir = [
            path: { "${params.outdir}/preprocess/extracted_reads/single_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    // Paired reads (1), unmapped (4), with an unmapped mate (8), primary alignments only (-256)
    withName: 'SAMTOOLS_VIEW_BOTH' {
        ext.args   = '--output-fmt bam -f 13 -F 256'
        publishDir = [
            path: { "${params.outdir}/preprocess/extracted_reads/both_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PARSE_INTEGRATION_SITES' {
        publishDir = [
            path: { "${params.outdir}/preprocess/converted_reads/parsed_integration_sites" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAMTOOLS_BAMTOFASTQ_SINGLE' {
        ext.args   = '-n'
        publishDir = [
            path: { "${params.outdir}/preprocess/converted_reads/single_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAMTOOLS_BAMTOFASTQ_BOTH' {
        ext.args   = '-n'
        publishDir = [
            path: { "${params.outdir}/preprocess/converted_reads/both_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KRAKEN2_SINGLE' {
        publishDir = [
            path: { "${params.outdir}/results/classified/single_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KRAKEN2_BOTH' {
        publishDir = [
            path: { "${params.outdir}/results/classified/both_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        REPORTING
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    // Keep the reads classified to a taxon other than unclassified (0) and root (1)
    withName: 'GAWK_SINGLE|GAWK_BOTH' {
        ext.args2  = '\'$1 != "U" && $3 != 1 && $3 != 0 { print $0 }\''
        ext.prefix = 'kraken_classified_reads_collated'
    }

    withName: 'GAWK_SINGLE' {
        publishDir = [
            path: { "${params.outdir}/results/classified/collate_kraken/single_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GAWK_BOTH' {
        publishDir = [
            path: { "${params.outdir}/results/classified/collate_kraken/both_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KRONA_KTIMPORTTAXONOMY_SINGLE' {
        ext.args   = '-t 3'
        publishDir = [
            path: { "${params.outdir}/results/kronaplots/single_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KRONA_KTIMPORTTAXONOMY_BOTH' {
        ext.args   = '-t 3'
        publishDir = [
            path: { "${params.outdir}/results/kronaplots/both_unmapped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'RANALYSIS' {
        publishDir = [
            path: { "${params.outdir}/results/analysis_report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
